# PostgreSQL Database Password
POSTGRES_PASSWORD=your_secure_postgres_password_here

# n8n Encryption Key (IMPORTANT: Generate a secure random string)
# You can generate one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=your_secure_encryption_key_here

# n8n Host Configuration
N8N_HOST=n8n.yourdomain.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.yourdomain.com

# Timezone
TIMEZONE=America/New_York

# Docker Image (change this to your registry/image name after building)
DOCKER_IMAGE=n8n-unlocked:latest

# Execution Settings
EXECUTIONS_MODE=regular
EXECUTIONS_TIMEOUT=3600
EXECUTIONS_TIMEOUT_MAX=7200

# Log Settings
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console

# =============================================================================
# Coolify Environment Variables for n8n Unlocked
# =============================================================================
# NOTE: In Coolify, these variables are set in the UI, not in a .env file
# This is a reference for what you need to configure in Coolify
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - Coolify Auto-Generated (Set by Coolify automatically)
# -----------------------------------------------------------------------------
# SERVICE_USER_POSTGRES       - Auto-generated by Coolify
# SERVICE_PASSWORD_POSTGRES   - Auto-generated by Coolify
# SERVICE_PASSWORD_ENCRYPTION - Auto-generated by Coolify (or set manually)
# SERVICE_URL_N8N             - Auto-generated by Coolify based on your domain

# -----------------------------------------------------------------------------
# OPTIONAL - Customizable Settings
# -----------------------------------------------------------------------------

# Database Name (default: n8n)
POSTGRES_DB=n8n

# Timezone Configuration
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# Security Settings (recommended defaults)
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_GIT_NODE_DISABLE_BARE_REPOS=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_PROXY_HOPS=1

# -----------------------------------------------------------------------------
# If deploying from Git in Coolify (RECOMMENDED)
# -----------------------------------------------------------------------------
# IMAGE=${IMAGE}  # Coolify sets this automatically

# -----------------------------------------------------------------------------
# If deploying pre-built image from registry
# -----------------------------------------------------------------------------
# IMAGE=ghcr.io/dgies1/n8n-unlocked:latest
# (or use your Docker Hub: dgies1/n8n-unlocked:latest)

# =============================================================================
# How to Generate Secure Values
# =============================================================================
#
# For SERVICE_PASSWORD_ENCRYPTION:
# openssl rand -hex 32
#
# For SERVICE_PASSWORD_POSTGRES:
# openssl rand -base64 32
#
# =============================================================================
